# Template for local environment variables. Copy to .env.local and fill in.
# .env.local is gitignored; this file is committed and must never hold a secret.
#
# Every variable the app reads is declared here. Adding one means touching
# .env.example, lib/env.ts, and the table in CLAUDE.md in the same change.

# Base URL of the backend API. No trailing slash.
#   local      -> http://localhost:3333
#   production -> https://api.seu-dominio.com.br
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333

# Request timeout in milliseconds. Optional, defaults to 10000.
# NEXT_PUBLIC_API_TIMEOUT=10000

# Server-only variables (no NEXT_PUBLIC_ prefix) go below. Anything prefixed
# NEXT_PUBLIC_ ships in the browser bundle and is public.
